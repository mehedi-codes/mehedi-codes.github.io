---
import {
	getCollection,
	render,
	type CollectionEntry,
} from "astro:content";
import Layout from "@/layouts/base.astro";
import Container from "@/components/helpers/container.astro";
import ui from "@/data/ui.json";

export const getStaticPaths = async () => {
	const entries = await getCollection("writings");
	return entries
		// Glob order is alphabetical by filename, so post-one, post-two,
		// post-three come back as one, three, two.
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
		.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

type Props = { entry: CollectionEntry<"writings"> };

const { entry } = Astro.props;
const { Content } = await render(entry);

// UTC is pinned, not incidental: `date` coerces to UTC midnight, so a formatter
// left on the host zone renders the previous day anywhere west of UTC.
const dateLabel = new Intl.DateTimeFormat("en-US", {
	dateStyle: "long",
	timeZone: "UTC",
}).format(entry.data.date);

// Post content is stored in one language, so both slots carry the same string.
// base.astro reads .en and .bn off these props, so handing it a bare string
// would not fail - it would quietly fall back to ui.meta.
const heading = `${entry.data.title} | ${ui.hero.title.en}`;
---

<Layout
	title={{ en: heading, bn: heading }}
	description={{ en: entry.data.description, bn: entry.data.description }}
>
	<Container id="writings" heading={ui.writings.title}>
		<a
			href="/writings"
			slot="action"
			class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
		>
			<span data-lang="en">{ui.writings.back.en}</span>
			<span data-lang="bn" lang="bn">{ui.writings.back.bn}</span>
		</a>

		<article class="flex flex-col gap-6 sm:gap-8">
			<header class="flex flex-col gap-3">
				<span lang="en" class="font-heading text-xs text-muted">
					{dateLabel}
				</span>
				<h2 lang="en" class="font-heading text-2xl sm:text-3xl font-bold text-ink">
					{entry.data.title}
				</h2>
				<p lang="en" class="text-sm sm:text-base leading-relaxed text-muted">
					{entry.data.description}
				</p>
				<ul lang="en" class="flex flex-wrap gap-2">
					{
						entry.data.tags.map((tag) => (
							<li class="border border-muted px-2 py-0.5 font-heading text-xs text-muted lowercase">
								{tag}
							</li>
						))
					}
				</ul>
			</header>

			{/*
				No @tailwindcss/typography in the project, so the body is styled
				with descendant variants. Only what blocks need to read correctly
				is covered; heading, code block and table typography waits until
				there is a body that actually uses them.
			*/}
			<div
				lang="en"
				class="text-sm sm:text-base leading-relaxed text-muted [&>*+*]:mt-4 [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-ink [&_code]:font-heading [&_li]:ml-4 [&_ol]:list-decimal [&_ul]:list-disc"
			>
				<Content />
			</div>
		</article>
	</Container>
</Layout>
---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/Container.astro";
import WorkCard from "@/components/WorkCard.astro";
import { projects } from "@/data/projects";
import { locale } from "@/i18n/locale";
---

<Layout
    title={{ en: locale.en["work.meta.title"], bn: locale.bn["work.meta.title"] }}
>
    <Container id="work" titleKey="work.title">
        <a
            href="/"
            slot="action"
            class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        >
            <span data-lang="en">{locale.en["notfound.cta"]}</span>
            <span data-lang="bn" lang="bn">{locale.bn["notfound.cta"]}</span>
        </a>
        <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6"
        >
            {
                projects.map((project, index) => (
                    <WorkCard index={index + 1} entry={project} />
                ))
            }
        </div>
    </Container>
</Layout>

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-implicit-coercion": "error",
    "unicorn/no-useless-undefined": "off",
    "no-unused-vars": "error",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist"]
}

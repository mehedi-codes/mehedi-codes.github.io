---
/** A heading that exists in both languages. Never ship one without the other. */
type LocalizedString = { en: string; bn: string };

type Props = { id?: string; heading?: LocalizedString };

const { id, heading } = Astro.props;
---

<section
	id={id}
	class="flex flex-col relative w-full scroll-mt-14 md:scroll-mt-16"
>
	<div class="w-full max-w-7xl mx-auto px-2 sm:px-4 md:px-6 lg:px-8">
		<div class="border-t border-subtle"></div>
	</div>
	<div
		class="w-full max-w-7xl mx-auto px-2 sm:px-4 md:px-6 lg:px-8 py-8 sm:py-12 md:py-16 lg:py-20"
	>
		{
			heading && (
				<div class="flex flex-wrap items-center justify-between gap-y-2 mb-6">
					<h2 class="font-heading text-xs sm:text-sm uppercase tracking-wider text-muted before:content-['//'] before:mr-1.5">
						<span data-lang="en">{heading.en}</span>
						<span data-lang="bn" lang="bn">
							{heading.bn}
						</span>
					</h2>
					<slot name="action" />
				</div>
			)
		}
		<slot />
	</div>
</section>
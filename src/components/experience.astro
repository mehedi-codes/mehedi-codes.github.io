---
import Container from "./container.astro";
import { experience, locale } from "@/content";
---

<Container id="experience" titleKey="experience.title">
	<a
		href="#"
		slot="action"
		class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
	>
		<span data-lang="en">{locale.en["resume.view"]}</span>
		<span data-lang="bn" lang="bn">{locale.bn["resume.view"]}</span>
	</a>
	<ol
		class="relative ml-3 space-y-10 sm:space-y-12 border-l border-subtle pb-4 md:ml-6"
	>
		{
			experience.map((entry) => (
				<li class="relative pl-8 md:pl-12">
					<span
						class={
							entry.active
								? "absolute top-1 -left-1.25 size-2.5 bg-ink glow-dot"
								: "absolute top-1 -left-1.25 size-2.5 border border-subtle bg-paper"
						}
						aria-hidden="true"
					/>
					<div class="mb-1 flex flex-col gap-x-4 md:flex-row md:items-baseline md:justify-between">
						<h3 class="font-heading font-bold text-base sm:text-lg text-ink">
							<span data-lang="en">{entry.title.en}</span>
							<span data-lang="en" class="font-normal text-muted">
								{" @ "}
								{entry.company.en}
							</span>
							<span data-lang="bn" lang="bn">
								{entry.title.bn}
							</span>
							<span data-lang="bn" class="font-normal text-muted">
								{" /\/ "}
								{entry.company.bn}
							</span>
						</h3>
						<span class="font-heading text-base text-muted">
							<span data-lang="en">{entry.period.en}</span>
							<span data-lang="bn" lang="bn">
								{entry.period.bn}
							</span>
						</span>
					</div>
					<p class="mb-1.5 font-heading text-xs text-muted lowercase">
						<span data-lang="en">{entry.tags.en}</span>
						<span data-lang="bn" lang="bn">
							{entry.tags.bn}
						</span>
					</p>
					<p class="text-sm sm:text-base leading-relaxed text-muted">
						<span data-lang="en">{entry.description.en}</span>
						<span data-lang="bn" lang="bn">
							{entry.description.bn}
						</span>
					</p>
				</li>
			))
		}
	</ol>
</Container>

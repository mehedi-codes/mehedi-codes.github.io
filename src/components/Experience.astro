---
import Container from "./Container.astro";
import { locale } from "@/i18n/locale";
---

<Container id="experience">
	<div class="flex flex-col gap-y-4 sm:gap-y-6 md:gap-y-8">
		<h2
			class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-balance"
		>
			<span data-lang="en">{locale.en["experience.title"]}</span>
			<span data-lang="bn" lang="bn">{locale.bn["experience.title"]}</span>
		</h2>
	</div>
</Container>
---
import Container from "./helpers/container.astro";
import WritingCard from "./writing-card.astro";
import writings from "@/data/writings.json";
import ui from "@/data/ui.json";
---

<Container id="writings" heading={ui.writings.title}>
	<a
		href="/writings"
		slot="action"
		class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink hover:bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
	>
		<span data-lang="en">{ui.writings["view-all"].en}</span>
		<span data-lang="bn" lang="bn">{ui.writings["view-all"].bn}</span>
	</a>
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
		{writings.map((entry) => <WritingCard entry={entry} />)}
	</div>
</Container>

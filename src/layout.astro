---
import "@/global.css";
import { ClientRouter } from "astro:transitions";
import { locale } from "@/content";
import { prepaint } from "@/scripts/prepaint";
import Breakpoint from "@/components/breakpoint.astro";
import Appbar from "@/components/appbar.astro";
import Header from "@/components/header.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title
			data-title-en={title?.en ?? locale.en["meta.title"]}
			data-title-bn={title?.bn ?? locale.bn["meta.title"]}
		>
			{title?.en ?? locale.en["meta.title"]}
		</title>
		<meta
			name="description"
			data-desc-en={locale.en["meta.description"]}
			data-desc-bn={locale.bn["meta.description"]}
			content={locale.en["meta.description"]}
		/>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/webp" href="/favicon.webp" />

		<script is:inline set:html={prepaint} />
	</head>
	<body class="font-body min-h-dvh flex flex-col pb-20 sm:pb-0 relative">
		<Header />
		<main class="flex-1 flex flex-col">
			<slot />
		</main>
		<Appbar />
		<Breakpoint />
	</body>
</html>

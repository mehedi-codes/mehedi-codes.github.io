---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

type Props = { entry: CollectionEntry<"writings"> };

const { entry } = Astro.props;
---

<article
	class="flex flex-col border border-subtle hover:border-muted transition-colors"
>
	<a
		href={`/writings/${entry.id}`}
		class="block outline -outline-offset-2 outline-transparent transition-colors duration-200 ease-linear hover:outline-subtle focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
	>
		<span class="sr-only">
			<span data-lang="en">{entry.data.title.en}</span>
			<span data-lang="bn" lang="bn">{entry.data.title.bn}</span>
		</span>
		<div class="aspect-video sm:aspect-3/2">
			<Image
				src={entry.data.image}
				alt=""
				width={640}
				height={360}
				loading="lazy"
				class="h-full w-full object-cover"
			/>
		</div>
	</a>
	<div class="flex flex-1 flex-col gap-3 p-6">
		<span class="font-heading text-xs text-muted">
			<span data-lang="en">{entry.data.dateLabel.en}</span>
			<span data-lang="bn" lang="bn">{entry.data.dateLabel.bn}</span>
		</span>
		<h3 class="font-heading font-bold text-lg text-ink">
			<a
				href={`/writings/${entry.id}`}
				class="hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
			>
				<span data-lang="en">{entry.data.title.en}</span>
				<span data-lang="bn" lang="bn">{entry.data.title.bn}</span>
			</a>
		</h3>
		<p class="text-sm sm:text-base leading-relaxed text-muted">
			<span data-lang="en">{entry.data.description.en}</span>
			<span data-lang="bn" lang="bn">{entry.data.description.bn}</span>
		</p>
		<ul class="mt-auto flex flex-wrap gap-2">
			{
				entry.data.tags.map((tag) => (
					<li class="border border-muted px-2 py-0.5 font-heading text-xs text-muted lowercase">
						<span data-lang="en">{tag.en}</span>
						<span data-lang="bn" lang="bn">
							{tag.bn}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</article>
---
import Container from "./Container.astro";
import { locale } from "@/i18n/locale";
---

<Container id="experience" titleKey="experience.title">
	<a
		href="#"
		slot="action"
		class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
	>
		<span data-lang="en">{locale.en["resume.view"]}</span>
		<span data-lang="bn" lang="bn">{locale.bn["resume.view"]}</span>
	</a>
</Container>
---
import "@/styles/global.css";
import { locale } from "@/i18n/locale";
import { prepaint } from "@/scripts/prepaint";
import TailwindIndicator from "@/components/TailwindIndicator.astro";
import Appbar from "@/components/Appbar.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title
			data-title-en={title?.en ?? locale.en["meta.title"]}
			data-title-bn={title?.bn ?? locale.bn["meta.title"]}
		>
			{title?.en ?? locale.en["meta.title"]}
		</title>
		<meta
			name="description"
			data-desc-en={locale.en["meta.description"]}
			data-desc-bn={locale.bn["meta.description"]}
			content={locale.en["meta.description"]}
		/>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/webp" href="/favicon.webp" />

		<script is:inline set:html={prepaint} />
	</head>
	<body class="font-body pb-20 sm:pb-0">
		<slot />
		<Appbar />
		<TailwindIndicator/>
	</body>
</html>

---
import { locale } from "@/i18n/locale";
import { Image } from "astro:assets";
---

<section
    class="relative flex w-full flex-col items-center overflow-hidden text-center gap-y-6 sm:gap-y-8 md:gap-y-10 lg:gap-y-12 px-2"
>
    <div class="hero-grid pointer-events-none absolute inset-0 -z-20"></div>
    <svg
        class="pointer-events-none absolute inset-0 -z-10 h-full w-full text-ink"
        viewBox="0 0 1440 800"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        aria-hidden="true"
    >
        <g fill="currentColor" class="opacity-[0.14]">
            <circle cx="90" cy="110" r="4"></circle>
            <circle cx="250" cy="210" r="3"></circle>
            <circle cx="190" cy="380" r="4"></circle>
            <circle cx="70" cy="470" r="3"></circle>
            <circle cx="250" cy="640" r="3.5"></circle>
            <circle cx="420" cy="120" r="3"></circle>

            <circle cx="1350" cy="130" r="4"></circle>
            <circle cx="1200" cy="230" r="3"></circle>
            <circle cx="1260" cy="400" r="4"></circle>
            <circle cx="1370" cy="500" r="3"></circle>
            <circle cx="1190" cy="650" r="3.5"></circle>
            <circle cx="1030" cy="150" r="3"></circle>
        </g>

        <g
            stroke="currentColor"
            stroke-width="1.25"
            class="opacity-[0.12]"
            transform="translate(120 560) rotate(-8)"
        >
            <rect x="0" y="0" width="110" height="62" rx="8"></rect>
            <line
                x1="16"
                y1="20"
                x2="62"
                y2="20"
                stroke-width="2.5"
                stroke-linecap="round"></line>
            <line
                x1="16"
                y1="32"
                x2="86"
                y2="32"
                stroke-width="2.5"
                stroke-linecap="round"></line>
            <line
                x1="16"
                y1="44"
                x2="48"
                y2="44"
                stroke-width="2.5"
                stroke-linecap="round"></line>
        </g>

        <g
            stroke="currentColor"
            stroke-width="1.25"
            class="opacity-[0.12]"
            transform="translate(1240 100) rotate(7)"
        >
            <rect x="0" y="0" width="118" height="66" rx="8"></rect>
            <line
                x1="16"
                y1="21"
                x2="68"
                y2="21"
                stroke-width="2.5"
                stroke-linecap="round"></line>
            <line
                x1="16"
                y1="34"
                x2="92"
                y2="34"
                stroke-width="2.5"
                stroke-linecap="round"></line>
            <line
                x1="16"
                y1="47"
                x2="54"
                y2="47"
                stroke-width="2.5"
                stroke-linecap="round"></line>
        </g>
    </svg>
    <div
        class="pointer-events-none absolute top-[44%] left-1/2 -z-10 size-168 -translate-x-1/2 -translate-y-1/2 rounded-full bg-ink/6 blur-3xl"
    >
    </div>
    <div class="pt-12">
        <Image
            src="/favicon.webp"
            alt="logo"
            width={240}
            height={240}
            class="w-40 h-40 sm:w-44 sm:h-44 md:w-48 md:h-48 lg:w-52 lg:h-52 xl:w-56 xl:h-56 2xl:w-60 2xl:h-60"
        />
    </div>
    <div class="w-full max-w-3xl flex-center flex-col gap-y-4 lg:gap-y-6">
        <div class="flex flex-col gap-y-3 sm:gap-y-4 font-heading">
            <h1
                class="text-4xl leading-tight font-bold tracking-tight text-balance sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl"
            >
                <span data-lang="en">{locale.en["hero.title"]}</span>
                <span data-lang="bn" lang="bn">{locale.bn["hero.title"]}</span>
            </h1>
            <p
                class="text-lg font-semibold tracking-wide sm:text-xl md:text-2xl lg:text-3xl"
            >
                <span data-lang="en">{locale.en["hero.designation"]}</span>
                <span data-lang="bn" lang="bn"
                    >{locale.bn["hero.designation"]}</span
                >
            </p>
        </div>
        <p
            class="w-full sm:max-w-2xl leading-relaxed text-muted text-base sm:text-lg md:text-xl"
        >
            <span data-lang="en">{locale.en["hero.biodata"]}</span>
            <span data-lang="bn" lang="bn">{locale.bn["hero.biodata"]}</span>
        </p>
    </div>
    <div
        class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-x-4"
    >
        <a
            href="#work"
            class="w-full sm:w-auto border border-ink bg-ink text-paper px-6 py-3 transition-colors duration-200 ease-linear hover:bg-paper hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            ><span data-lang="en">{locale.en["hero.primary-btn"]}</span><span
                data-lang="bn"
                lang="bn">{locale.bn["hero.primary-btn"]}</span
            ></a
        >
        <a
            href="#contact"
            class="w-full sm:w-auto border border-muted px-6 py-3 transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            ><span data-lang="en">{locale.en["hero.secondary-btn"]}</span><span
                data-lang="bn"
                lang="bn">{locale.bn["hero.secondary-btn"]}</span
            ></a
        >
    </div>
</section>

---
import Layout from "@/layouts/base.astro";
import Container from "@/components/helpers/container.astro";
import ui from "@/data/ui.json";
import works from "@/data/works.json";
import type { Work } from "@/components/work-card.astro";

export const getStaticPaths = () => {
	return works.map((work) => ({
		params: { slug: work.slug },
		props: { work },
	}));
};

type Props = { work: Work };
const { work } = Astro.props;

// The parameter is named `w`, not `work`, on purpose: shadowing the prop would
// make this `w.slug === w.slug`, which is true for the first entry every time
// and pins every page's "next" link to the same project.
const index = works.findIndex((w) => w.slug === work.slug);

// No bounds checks. astro/tsconfigs/strictest turns on noUncheckedIndexedAccess,
// so an out-of-range index is already typed Work | undefined and the first and
// last projects fall out of the type rather than out of a ternary.
//
// Deliberately not .at(): that wraps, so at(-1) on the first project would
// return the last one and link it as "previous".
const prev = works[index - 1];
const next = works[index + 1];

const linkClass =
	"flex-1 flex items-center justify-center gap-1.5 border border-muted px-3 py-1.5 text-xs transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink";
---

<Layout
	title={{
		en: `${work.title.en} | ${ui.hero.title.en}`,
		bn: `${work.title.bn} | ${ui.hero.title.bn}`,
	}}
	description={work.description}
>
	<Container id="works" heading={ui.works.title}>
		<a
			href="/works"
			slot="action"
			class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
		>
			<span data-lang="en">{ui.works.detail.back.en}</span>
			<span data-lang="bn" lang="bn">{ui.works.detail.back.bn}</span>
		</a>

		<article class="flex flex-col gap-6 sm:gap-8">
			<img
				src={work.image.light}
				data-light-src={work.image.light}
				data-dark-src={work.image.dark}
				alt=""
				width={1280}
				height={640}
				loading="eager"
				decoding="async"
				class="aspect-2/1 w-full border border-subtle object-cover"
			/>
			<header class="flex flex-col gap-3">
				<h2 class="font-heading text-xl sm:text-2xl font-bold text-ink">
					<span data-lang="en">{work.title.en}</span>
					<span data-lang="bn" lang="bn">{work.title.bn}</span>
				</h2>
				<p class="text-sm sm:text-base leading-relaxed text-muted">
					<span data-lang="en">{work.description.en}</span>
					<span data-lang="bn" lang="bn">{work.description.bn}</span>
				</p>
				<ul class="flex flex-wrap gap-2">
					{
						work.tags.map((tag) => (
							<li class="border border-muted px-2 py-0.5 font-heading text-xs text-muted lowercase">
								<span data-lang="en">{tag.en}</span>
								<span data-lang="bn" lang="bn">
									{tag.bn}
								</span>
							</li>
						))
					}
				</ul>
			</header>

			<section class="flex flex-col gap-3">
				<h3
					class="font-heading text-xs sm:text-sm uppercase tracking-wider text-muted before:content-['//'] before:mr-1.5"
				>
					<span data-lang="en">{ui.works.detail.highlights.en}</span>
					<span data-lang="bn" lang="bn">
						{ui.works.detail.highlights.bn}
					</span>
				</h3>
				<ul class="list-none space-y-1.5">
					{
						work.highlights.en.map((text, i) => (
							<li class="relative pl-4 text-sm sm:text-base leading-relaxed text-muted before:absolute before:left-0 before:top-[0.7em] before:size-1 before:rounded-full before:bg-subtle">
								<span data-lang="en">{text}</span>
								<span data-lang="bn" lang="bn">
									{work.highlights.bn[i]}
								</span>
							</li>
						))
					}
				</ul>
			</section>

			<hr class="border-subtle" />

			<footer class="flex flex-wrap gap-2.5 max-w-sm">
				<a
					href={work.live}
					target="_blank"
					rel="noopener"
					class={linkClass}
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-3.5 shrink-0"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="10"></circle>
						<path
							d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"
						></path>
						<path d="M2 12h20"></path>
					</svg>
					<span data-lang="en">{ui.works.card.live.en}</span>
					<span data-lang="bn" lang="bn">{ui.works.card.live.bn}</span
					>
				</a>
				<a
					href={work.source}
					target="_blank"
					rel="noopener"
					class={linkClass}
				>
					<svg
						viewBox="0 0 24 24"
						fill="currentColor"
						class="size-3.5 shrink-0"
						aria-hidden="true"
					>
						<path
							d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2.2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1 2 .8 2.6 1.2.3-1 .9-1.5 1.5-1.8-2.6-.3-5.4-1.3-5.4-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .2 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.9 1.2 1.9 1.2 3.2 0 4.5-2.8 5.5-5.4 5.8.9.8 1.7 2.3 1.7 4.7v2.9c0 .4.2.7.8.6 4.7-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"
						></path>
					</svg>
					<span data-lang="en">{ui.works.card.source.en}</span>
					<span data-lang="bn" lang="bn">
						{ui.works.card.source.bn}
					</span>
				</a>
			</footer>
		</article>

		{
			(prev || next) && (
				<nav class="mt-10 sm:mt-14 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
					{prev ? (
						<a
							href={`/works/${prev.slug}`}
							class="group flex flex-col gap-1 border border-subtle p-5 transition-colors duration-200 ease-linear hover:border-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
						>
							<span class="font-heading text-xs text-muted">
								<span data-lang="en">
									{ui.works.detail.prev.en}
								</span>
								<span data-lang="bn" lang="bn">
									{ui.works.detail.prev.bn}
								</span>
							</span>
							<span class="font-heading font-bold text-ink">
								<span data-lang="en">{prev.title.en}</span>
								<span data-lang="bn" lang="bn">
									{prev.title.bn}
								</span>
							</span>
						</a>
					) : (
						<span />
					)}
					{next && (
						<a
							href={`/works/${next.slug}`}
							class="group flex flex-col gap-1 border border-subtle p-5 text-right transition-colors duration-200 ease-linear hover:border-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
						>
							<span class="font-heading text-xs text-muted">
								<span data-lang="en">
									{ui.works.detail.next.en}
								</span>
								<span data-lang="bn" lang="bn">
									{ui.works.detail.next.bn}
								</span>
							</span>
							<span class="font-heading font-bold text-ink">
								<span data-lang="en">{next.title.en}</span>
								<span data-lang="bn" lang="bn">
									{next.title.bn}
								</span>
							</span>
						</a>
					)}
				</nav>
			)
		}
	</Container>
</Layout>

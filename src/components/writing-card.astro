---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

type Props = { entry: CollectionEntry<"writings"> };

const { entry } = Astro.props;

// UTC is pinned, not incidental: `date` coerces to UTC midnight, so a formatter
// left on the host zone renders the previous day anywhere west of UTC.
const dateLabel = new Intl.DateTimeFormat("en-US", {
	dateStyle: "long",
	timeZone: "UTC",
}).format(entry.data.date);
---

<article
	class="flex flex-col border border-subtle hover:border-muted transition-colors"
>
	<a
		href={`/writings/${entry.id}`}
		class="block outline -outline-offset-2 outline-transparent transition-colors duration-200 ease-linear hover:outline-subtle focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
	>
		<span class="sr-only">{entry.data.title}</span>
		<div class="aspect-video sm:aspect-3/2">
			<Image
				src={entry.data.image}
				alt=""
				width={640}
				height={360}
				loading="lazy"
				class="h-full w-full object-cover"
			/>
		</div>
	</a>
	<div class="flex flex-1 flex-col gap-3 p-6">
		<span lang="en" class="font-heading text-xs text-muted">
			{dateLabel}
		</span>
		<h3 lang="en" class="font-heading font-bold text-lg text-ink">
			<a
				href={`/writings/${entry.id}`}
				class="hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
			>
				{entry.data.title}
			</a>
		</h3>
		<p lang="en" class="text-sm sm:text-base leading-relaxed text-muted">
			{entry.data.description}
		</p>
		<ul lang="en" class="mt-auto flex flex-wrap gap-2">
			{
				entry.data.tags.map((tag) => (
					<li class="border border-muted px-2 py-0.5 font-heading text-xs text-muted lowercase">
						{tag}
					</li>
				))
			}
		</ul>
	</div>
</article>
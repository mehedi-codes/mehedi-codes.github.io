---
import type { WritingEntry } from "@/utils/content";
import { Image } from "astro:assets";

type Props = { entry: WritingEntry };

const { entry } = Astro.props;
---

<a
	href={entry.url}
	class="group flex flex-col border border-subtle hover:border-muted transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
>
	<div class="aspect-video sm:aspect-3/2">
		<Image
			src={entry.image}
			alt=""
			width={640}
			height={360}
			loading="lazy"
			class="h-full w-full object-cover"
		/>
	</div>
	<div class="flex flex-1 flex-col gap-3 p-6">
		<span class="flex-between">
			<span class="font-heading text-xs text-muted">
				<span data-lang="en">{entry.date.en}</span>
				<span data-lang="bn" lang="bn">{entry.date.bn}</span>
			</span>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-4 text-muted group-hover:text-ink transition-colors"
				aria-hidden="true"
			>
				<path d="M7 7h10v10"></path>
				<path d="M7 17 17 7"></path>
			</svg>
		</span>
		<h3 class="font-heading font-bold text-lg text-ink">
			<span data-lang="en">{entry.title.en}</span>
			<span data-lang="bn" lang="bn">{entry.title.bn}</span>
		</h3>
		<p class="text-sm sm:text-base leading-relaxed text-muted">
			<span data-lang="en">{entry.description.en}</span>
			<span data-lang="bn" lang="bn">{entry.description.bn}</span>
		</p>
		<ul class="mt-auto flex flex-wrap gap-2">
			{
				entry.tags.map((tag) => (
					<li
						class="border border-muted px-2 py-0.5 font-heading text-xs text-muted lowercase"
					>
						<span data-lang="en">{tag.en}</span>
						<span data-lang="bn" lang="bn">{tag.bn}</span>
					</li>
				))
			}
		</ul>
	</div>
</a>

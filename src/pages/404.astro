---
import Layout from "@/layouts/base.astro";
import ui from "@/data/ui.json";
---

<Layout
    title={ui.meta["404-title"]}
>
    <section
        class="relative flex-1 flex-center flex-col text-center gap-y-8 px-2 sm:px-4 md:px-6 lg:px-8 overflow-hidden"
    >
        <div class="hero-grid pointer-events-none absolute inset-0 -z-20"></div>
        <div class="flex-col flex-center gap-8 max-w-3xl">
            <div class="relative z-0 flex-center flex-col gap-4">
                <h1 class="font-black text-ink text-9xl">
                    <span data-lang="en">{ui.notfound.code.en}</span>
                    <span data-lang="bn" lang="bn"
                        >{ui.notfound.code.bn}</span
                    >
                </h1>
                <h2
                    class="font-heading text-2xl font-semibold tracking-wide text-ink sm:text-3xl"
                >
                    <span data-lang="en">{ui.notfound.title.en}</span>
                    <span data-lang="bn" lang="bn"
                        >{ui.notfound.title.bn}</span
                    >
                </h2>
                <p class="text-lg leading-relaxed text-muted">
                    <span data-lang="en">{ui.notfound.message.en}</span>
                    <span data-lang="bn" lang="bn"
                        >{ui.notfound.message.bn}</span
                    >
                </p>
            </div>
            <a
                href="/"
                class="relative z-0 border border-muted text-ink px-6 py-3 transition-colors duration-200 hover:bg-ink hover:text-paper"
            >
                <span data-lang="en">{ui.notfound.cta.en}</span>
                <span data-lang="bn" lang="bn">{ui.notfound.cta.bn}</span>
            </a>
        </div>
    </section>
</Layout>

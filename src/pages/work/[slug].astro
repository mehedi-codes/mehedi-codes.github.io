---
import Layout from "@/layouts/base.astro";
import Container from "@/components/helpers/container.astro";
import { locale, projects, type ProjectEntry } from "@/utils/content";
import { Image } from "astro:assets";

export function getStaticPaths() {
	return projects.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

type Props = { entry: ProjectEntry };

const { entry } = Astro.props;
const index = projects.findIndex((project) => project.slug === entry.slug);
const newer = index > 0 ? projects[index - 1] : undefined;
const older = index < projects.length - 1 ? projects[index + 1] : undefined;
const liveHost = entry.live.replace(/^https?:\/\//, "").replace(/\/$/, "");

const linkClass =
	"flex items-center gap-1.5 border border-muted px-3 py-1.5 text-xs transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink";
---

<Layout
	title={{
		en: `${entry.title.en} | Mehedi Hasan`,
		bn: `${entry.title.bn} | মেহেদি হাসান`,
	}}
	description={entry.description}
>
	<Container id="work" titleKey="work.title">
		<a
			href="/work"
			slot="action"
			class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
		>
			<span data-lang="en">{locale.en["work.detail.back"]}</span>
			<span data-lang="bn" lang="bn">{locale.bn["work.detail.back"]}</span>
		</a>

		<article class="flex flex-col gap-6 sm:gap-8">
			<div class="aspect-2/1 border border-subtle">
				<Image
					src={entry.image}
					alt=""
					width={1280}
					height={640}
					loading="eager"
					class="h-full w-full object-cover dark:opacity-90"
				/>
			</div>

			<header class="flex flex-col gap-3">
				<h2 class="font-heading text-xl sm:text-2xl font-bold text-ink">
					<span data-lang="en">{entry.title.en}</span>
					<span data-lang="bn" lang="bn">{entry.title.bn}</span>
				</h2>
				<p class="text-sm sm:text-base leading-relaxed text-muted">
					<span data-lang="en">{entry.description.en}</span>
					<span data-lang="bn" lang="bn">{entry.description.bn}</span>
				</p>
				<ul class="flex flex-wrap gap-2">
					{
						entry.tags.map((tag) => (
							<li
								class="border border-muted px-2 py-0.5 font-heading text-xs text-muted lowercase"
							>
								<span data-lang="en">{tag.en}</span>
								<span data-lang="bn" lang="bn">{tag.bn}</span>
							</li>
						))
					}
				</ul>
			</header>

			<section class="flex flex-col gap-3">
				<h3
					class="font-heading text-xs sm:text-sm uppercase tracking-wider text-muted before:content-['//'] before:mr-1.5"
				>
					<span data-lang="en">{locale.en["work.detail.highlights"]}</span>
					<span data-lang="bn" lang="bn">
						{locale.bn["work.detail.highlights"]}
					</span>
				</h3>
				<ul class="list-none space-y-1.5">
					{
						entry.highlights.en.map((text, i) => (
							<li class="relative pl-4 text-sm sm:text-base leading-relaxed text-muted before:absolute before:left-0 before:top-[0.7em] before:size-1 before:rounded-full before:bg-subtle">
								<span data-lang="en">{text}</span>
								<span data-lang="bn" lang="bn">
									{entry.highlights.bn[i]}
								</span>
							</li>
						))
					}
				</ul>
			</section>

			<hr class="border-subtle" />

			<footer class="flex flex-wrap items-center gap-x-4 gap-y-3">
				<span class="font-heading text-xs text-muted truncate min-w-0"
					>{liveHost}</span
				>
				<div class="flex flex-wrap gap-2.5">
					<a href={entry.live} target="_blank" rel="noopener" class={linkClass}>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-3.5 shrink-0"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="10"></circle>
							<path
								d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"
							></path>
							<path d="M2 12h20"></path>
						</svg>
						<span data-lang="en">{locale.en["work.card.live"]}</span>
						<span data-lang="bn" lang="bn">{locale.bn["work.card.live"]}</span>
					</a>
					<a href={entry.source} target="_blank" rel="noopener" class={linkClass}>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							class="size-3.5 shrink-0"
							aria-hidden="true"
						>
							<path
								d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2.2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1 2 .8 2.6 1.2.3-1 .9-1.5 1.5-1.8-2.6-.3-5.4-1.3-5.4-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .2 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.9 1.2 1.9 1.2 3.2 0 4.5-2.8 5.5-5.4 5.8.9.8 1.7 2.3 1.7 4.7v2.9c0 .4.2.7.8.6 4.7-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"
							></path>
						</svg>
						<span data-lang="en">{locale.en["work.card.source"]}</span>
						<span data-lang="bn" lang="bn">
							{locale.bn["work.card.source"]}
						</span>
					</a>
				</div>
			</footer>
		</article>

		{
			(newer || older) && (
				<nav class="mt-10 sm:mt-14 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
					{newer ? (
						<a
							href={newer.url}
							class="group flex flex-col gap-1 border border-subtle p-5 transition-colors duration-200 ease-linear hover:border-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
						>
							<span class="font-heading text-xs text-muted">
								<span data-lang="en">{locale.en["work.detail.newer"]}</span>
								<span data-lang="bn" lang="bn">
									{locale.bn["work.detail.newer"]}
								</span>
							</span>
							<span class="font-heading font-bold text-ink">
								<span data-lang="en">{newer.title.en}</span>
								<span data-lang="bn" lang="bn">{newer.title.bn}</span>
							</span>
						</a>
					) : (
						<span />
					)}
					{older && (
						<a
							href={older.url}
							class="group flex flex-col gap-1 border border-subtle p-5 text-right transition-colors duration-200 ease-linear hover:border-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
						>
							<span class="font-heading text-xs text-muted">
								<span data-lang="en">{locale.en["work.detail.older"]}</span>
								<span data-lang="bn" lang="bn">
									{locale.bn["work.detail.older"]}
								</span>
							</span>
							<span class="font-heading font-bold text-ink">
								<span data-lang="en">{older.title.en}</span>
								<span data-lang="bn" lang="bn">{older.title.bn}</span>
							</span>
						</a>
					)}
				</nav>
			)
		}
	</Container>
</Layout>

---
import writings from "@/data/writings.json";
import { Image } from "astro:assets";

/** Inferred from the data, so the two cannot drift apart. */
type WritingEntry = (typeof writings)[number];

type Props = { entry: WritingEntry };

const { entry } = Astro.props;

// Rendered as <article>, not <a>: writings.json has no `slug`, so there is no
// detail page to link to and the old /writing/post-* targets were dead. Adding
// `slug` back and a [slug].astro route turns this into a link again.
---

<article
	class="flex flex-col border border-subtle"
>
	<div class="aspect-video sm:aspect-3/2">
		<Image
			src={entry.image}
			alt=""
			width={640}
			height={360}
			loading="lazy"
			class="h-full w-full object-cover"
		/>
	</div>
	<div class="flex flex-1 flex-col gap-3 p-6">
		<span class="flex-between">
			<span class="font-heading text-xs text-muted">
				<span data-lang="en">{entry.date.en}</span>
				<span data-lang="bn" lang="bn">{entry.date.bn}</span>
			</span>
		</span>
		<h3 class="font-heading font-bold text-lg text-ink">
			<span data-lang="en">{entry.title.en}</span>
			<span data-lang="bn" lang="bn">{entry.title.bn}</span>
		</h3>
		<p class="text-sm sm:text-base leading-relaxed text-muted">
			<span data-lang="en">{entry.description.en}</span>
			<span data-lang="bn" lang="bn">{entry.description.bn}</span>
		</p>
		<ul class="mt-auto flex flex-wrap gap-2">
			{
				entry.tags.map((tag) => (
					<li class="border border-muted px-2 py-0.5 font-heading text-xs text-muted lowercase">
						<span data-lang="en">{tag.en}</span>
						<span data-lang="bn" lang="bn">
							{tag.bn}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</article>

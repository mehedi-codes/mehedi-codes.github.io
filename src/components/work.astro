---
import Container from "./helpers/container.astro";
import WorkCard from "./work-card.astro";
import { locale } from "@/i18n";
import { projects } from "@/contents/projects";

/**
 * The homepage previews the work section; `/work` lists all of it behind the
 * "view all" action. Capped at three so the `lg:grid-cols-3` row stays full
 * instead of orphaning a single card on the second row.
 */
const PREVIEW_COUNT = 3;
const preview = projects.slice(0, PREVIEW_COUNT);
---

<Container id="work" titleKey="work.title">
	<a
		href="/work"
		slot="action"
		class="border border-muted px-5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-colors duration-200 ease-linear hover:border-ink hover:text-ink hover:bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
	>
		<span data-lang="en">{locale.en["work.view-all"]}</span>
		<span data-lang="bn" lang="bn">{locale.bn["work.view-all"]}</span>
	</a>
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
		{
			preview.map((project, index) => (
				<WorkCard index={index + 1} entry={project} />
			))
		}
	</div>
</Container>

---
import { locale, type TranslationKey } from "@/i18n/locale";

type Props = { id?: string; titleKey?: TranslationKey };

const { id, titleKey } = Astro.props;
---

<section
	id={id}
	class="flex flex-col relative w-full scroll-mt-14 md:scroll-mt-16"
>
	<div
		class="w-full max-w-7xl mx-auto px-2 sm:px-4 md:px-6 lg:px-8 py-8 sm:py-12 md:py-16 lg:py-20"
	>
		{titleKey && (
			<h2
				class="font-heading text-xs sm:text-sm uppercase tracking-wider text-muted mb-6 before:content-['//'] before:mr-1.5"
			>
				<span data-lang="en">{locale.en[titleKey]}</span>
				<span data-lang="bn" lang="bn">{locale.bn[titleKey]}</span>
			</h2>
		)}
		<slot />
	</div>
</section>

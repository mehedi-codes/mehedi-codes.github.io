---
interface Props {
	id?: string;
}

const { id } = Astro.props;
---

<section
	id={id}
	class="min-h-dvh flex flex-col relative w-full scroll-mt-14 md:scroll-mt-16"
>
	<div
		class="w-full max-w-7xl mx-auto px-2 sm:px-4 md:px-6 lg:px-8 py-10 sm:py-14 md:py-16 lg:py-20 xl:py-24"
	>
		<slot />
	</div>
</section>
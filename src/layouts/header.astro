---
import ThemeToggle from "../components/theme-toggle.astro";
import LangToggle from "../components/lang-toggle.astro";
import { locale } from "@/utils/content";

const links = [
    { key: "nav.experience", href: "/#experience" },
    { key: "nav.work", href: "/work" },
    { key: "nav.writing", href: "/writing" },
    { key: "nav.contact", href: "/#contact" },
] as const;

const pathname = Astro.url.pathname;
const isPageActive = (href: string) =>
    !href.startsWith("/#") &&
    (pathname === href || pathname.startsWith(`${href}/`));
---

<header
    class="py-3 md:py-4 text-muted sticky top-0 z-50 bg-paper/80 backdrop-blur-md w-full"
>
    <div
        class="w-full max-w-7xl flex-between mx-auto font-heading px-2 sm:px-4 md:px-6 lg:px-8"
    >
        <a
            href="/"
            class="text-lg sm:text-xl md:text-2xl font-semibold shimmer-text"
        >
            <span data-lang="en">{locale.en.logo}</span>
            <span data-lang="bn" lang="bn">{locale.bn.logo}</span>
        </a>
        <nav class="flex-between gap-x-3 sm:gap-x-4 md:gap-x-6 lg:gap-x-8">
            {
                links.map((link) => (
                    <a
                        class="link-underline hidden sm:inline text-sm md:text-base"
                        aria-current={
                            isPageActive(link.href) ? "page" : undefined
                        }
                        href={link.href}
                    >
                        <span data-lang="en">{locale.en[link.key]}</span>
                        <span data-lang="bn" lang="bn">
                            {locale.bn[link.key]}
                        </span>
                    </a>
                ))
            }
            <LangToggle />
            <ThemeToggle />
        </nav>
    </div>
</header>
